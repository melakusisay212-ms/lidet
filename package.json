{
  "name": "lidet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lidet / ልደቴ — Ethiopian-calendar-first birthday, countdown and events app (Android, offline-first).",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test \"tests/**/*.test.ts\"",
    "build": "vite build",
    "check": "npm run typecheck && npm test && npm run build",
    "android:prepare": "node scripts/prepare-android.mjs",
    "android:sync": "cap sync android"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^6.0.2",
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.2",
    "@capacitor/local-notifications": "^6.1.0",
    "@capacitor/share": "^6.0.3",
    "@fontsource/manrope": "^5.1.0",
    "@fontsource/noto-sans-ethiopic": "^5.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=20.19"
  }
